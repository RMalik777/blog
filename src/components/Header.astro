---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
	lang: Lang;
	alternates?: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<header class="container-page flex items-center justify-between py-4 sm:py-6">
	<a
		href={getRelativeLocaleUrl(lang)}
		class="font-sans text-[0.9375rem] font-medium tracking-tight transition-colors hover:text-primary"
	>
		{t("site.title")}
	</a>
	<div class="-mr-2 flex items-center gap-1">
		<LanguageSwitch lang={lang} alternates={alternates} />
		<ThemeToggle lang={lang} />
	</div>
</header>
