---
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const links = [
	{ title: "GitHub", href: "https://github.com/RMalik777" },
	{ title: "LinkedIn", href: "https://www.linkedin.com/in/raflimalik/" },
	{ title: "Instagram", href: "https://www.instagram.com/raflimalik__/" },
	{ title: "Unsplash", href: "https://unsplash.com/@raflimalik" },
	{ title: "Email", href: "mailto:rafli.malik@gmail.com" },
];

const linkClass =
	"underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-current";
---

<footer class="container-page mt-24 pb-10 font-sans text-sm text-muted-foreground sm:mt-36">
	<div class="flex flex-col gap-6 border-t pt-6 sm:flex-row sm:items-start sm:justify-between">
		<ul class="flex flex-wrap gap-x-5 gap-y-2">
			{links.map((link) => (
				<li>
					<a href={link.href} class="transition-colors hover:text-foreground">
						{link.title}
					</a>
				</li>
			))}
		</ul>
		<div class="flex flex-col gap-1 sm:max-w-sm sm:text-right">
			<p>
				<a href="https://raflimalik.com" class="text-foreground transition-colors hover:text-primary">
					Rafli Malik
				</a>
				, {new Date().getFullYear()}
			</p>
			<p>
				{t("footer.license.content")}{" "}
				<a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" class={linkClass}>
					CC BY 4.0
				</a>
				. {t("footer.license.code")}{" "}
				<a href="https://github.com/RMalik777/blog" rel="noopener" class={linkClass}>
					MIT
				</a>
				.
			</p>
		</div>
	</div>
</footer>
