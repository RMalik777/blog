---
import { PortableText } from "astro-portabletext";
import type { TypedObject } from "astro-portabletext/types";
import Link from "@/components/portable-text/Link.astro";
import { cn } from "@/lib/utils";

interface Props {
	value: TypedObject[] | null | undefined;
	class?: string;
}

const { value, class: className } = Astro.props;

const components = {
	mark: {
		link: Link,
	},
};
---

{value?.length ? (
	<div class={cn("prose-body", className)}>
		<PortableText value={value} components={components} />
	</div>
) : null}

<style>
	@reference "../styles/global.css";

	/*
	 * Long-form reading column: Newsreader at a comfortable measure.
	 * PortableText renders the children in other components, so their selectors need :global().
	 * Kept in the components layer so utilities passed through `class` still win.
	 */
	@layer components {
		.prose-body {
			@apply max-w-[68ch] font-serif text-[1.1875rem] leading-[1.7] text-foreground;
		}
		.prose-body > :global(* + *) {
			margin-top: 1.1em;
		}
		.prose-body :global(h2) {
			@apply mt-[2em] text-[1.75rem] leading-tight font-normal tracking-tight;
		}
		.prose-body :global(h3) {
			@apply mt-[1.75em] text-[1.375rem] leading-snug font-medium;
		}
		.prose-body :global(h4) {
			@apply mt-[1.5em] font-sans text-base font-semibold;
		}
		.prose-body :global(a) {
			@apply text-primary underline decoration-primary/40 underline-offset-[0.18em] transition-colors hover:decoration-primary;
		}
		.prose-body :global(blockquote) {
			@apply border-l-2 border-primary pl-5 text-[1.25rem] italic;
		}
		.prose-body :global(ul),
		.prose-body :global(ol) {
			@apply pl-6;
		}
		.prose-body :global(ul) {
			@apply list-disc;
		}
		.prose-body :global(ol) {
			@apply list-decimal;
		}
		.prose-body :global(li + li) {
			margin-top: 0.35em;
		}
		.prose-body :global(li::marker) {
			@apply text-muted-foreground;
		}
		.prose-body :global(code) {
			@apply rounded-[2px] bg-muted px-1 py-0.5 font-mono text-[0.85em];
		}
	}
</style>
