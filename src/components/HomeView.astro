---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPosts } from "@/lib/sanity";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Layout lang={lang} alternates={{ en: getRelativeLocaleUrl("en"), id: getRelativeLocaleUrl("id") }}>
	<div class="container-page">
		<h1 class="max-w-[16ch] pt-10 pb-12 font-serif text-[2.75rem] leading-[1.05] font-light tracking-[-0.02em] sm:pt-16 sm:pb-20 sm:text-[4.5rem]">
			{t("site.description")}
		</h1>

		{posts.length > 0 ? (
			<ol class="grid gap-20 sm:gap-28">
				{posts.map((post, index) => (
					<li>
						<PostCard post={post} lang={lang} priority={index === 0} />
					</li>
				))}
			</ol>
		) : (
			<div class="grid max-w-[60ch] gap-3 border-t pt-8">
				<p class="font-serif text-xl">{t("posts.empty")}</p>
				{lang !== "en" && (
					<a
						href={getRelativeLocaleUrl("en")}
						hreflang="en"
						class="w-fit font-sans text-sm text-primary underline underline-offset-4"
					>
						{t("posts.emptyLink")}
					</a>
				)}
			</div>
		)}
	</div>
</Layout>
