---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import PostTile from "@/components/PostTile.astro";
import { getPosts } from "@/lib/sanity";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);

// The home page shows the latest post in full and a few earlier ones; the rest live on /posts
const EARLIER_COUNT = 4;
const [latest, ...rest] = posts;
const earlier = rest.slice(0, EARLIER_COUNT);
---

<Layout lang={lang} alternates={{ en: getRelativeLocaleUrl("en"), id: getRelativeLocaleUrl("id") }}>
	<div class="container-page">
		<h1 class="max-w-[16ch] pt-10 pb-12 font-serif text-[2.75rem] leading-[1.05] font-light tracking-[-0.02em] sm:pt-16 sm:pb-20 sm:text-[4.5rem]">
			{t("site.description")}
		</h1>

		{latest ? (
			<div class="grid gap-20 sm:gap-28">
				<PostCard post={latest} lang={lang} priority />
				{earlier.length > 0 && (
					<section class="grid gap-8 border-t pt-4 sm:gap-10" aria-labelledby="earlier-heading">
						<div class="flex items-baseline justify-between gap-4">
							<h2 id="earlier-heading" class="font-serif text-2xl font-light text-muted-foreground">
								{t("posts.earlier")}
							</h2>
							<a
								href={getRelativeLocaleUrl(lang, "posts")}
								class="font-sans text-sm text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-current"
							>
								{t("posts.allCount").replace("{count}", String(posts.length))}
							</a>
						</div>
						<ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
							{earlier.map((post) => (
								<li>
									<PostTile post={post} lang={lang} />
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		) : (
			<div class="grid max-w-[60ch] gap-3 border-t pt-8">
				<p class="font-serif text-xl">{t("posts.empty")}</p>
				{lang !== "en" && (
					<a
						href={getRelativeLocaleUrl("en")}
						hreflang="en"
						class="w-fit font-sans text-sm text-primary underline underline-offset-4"
					>
						{t("posts.emptyLink")}
					</a>
				)}
			</div>
		)}
	</div>
</Layout>
