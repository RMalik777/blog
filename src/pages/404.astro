---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations("en");
---

<Layout title={t("notFound.title")} description={t("notFound.body")}>
	<div class="container-page grid gap-6 pt-16 pb-8 sm:pt-28">
		<h1 class="max-w-[14ch] font-serif text-[2.75rem] leading-[1.05] font-light tracking-[-0.02em] sm:text-[4.75rem]">
			{t("notFound.title")}
		</h1>
		<p class="max-w-[48ch] font-serif text-xl">{t("notFound.body")}</p>
		<a
			href={getRelativeLocaleUrl("en")}
			class="w-fit font-sans text-sm text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
		>
			{t("notFound.home")}
		</a>
	</div>
</Layout>
